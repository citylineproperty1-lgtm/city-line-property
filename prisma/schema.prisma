// City Line Property — Prisma schema
// CRM-enabled schema: categories, inventory, leads, admin users, settings.
// Extras (agents, testimonials, newsletter, view events, blog posts) removed —
// the platform is a focused property catalog + CRM.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Property {
  id           String      @id @default(cuid())
  title        String
  slug         String      @unique
  // Short inventory code, e.g. CLP-101 (auto-assigned on create)
  reference    String      @unique
  description  String
  // price in PKR (per month when status = RENT)
  price        Float
  // SALE | RENT
  status       String
  // Category slug from Category table (residential-plots, houses, for-rent, ...)
  type         String
  beds         Int
  baths        Int
  // area in sqft (plots: total sqft of the plot)
  area         Int
  address      String
  city         String
  // One of the 5 areas: Etihad Town Phase 1 | Etihad Town Phase 2 | Royal Enclave | Premier Enclave | Overseas Block
  district     String
  // JSON string array of image paths
  images       String
  // JSON string array of amenity names
  amenities    String
  featured     Boolean     @default(false)
  // Inventory availability: AVAILABLE | RESERVED | SOLD | RENTED
  listingState String      @default("AVAILABLE")
  // Draft listings are hidden from the public site
  published    Boolean     @default(true)
  yearBuilt    Int
  parking      Int
  views        Int         @default(0)
  leads        Lead[]
  visits       SiteVisit[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// Managed from the admin panel — icons are lucide icon names.
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  icon        String   @default("Building2")
  color       String   @default("#0F766E")
  description String   @default("")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

// Client requirement / inquiry captured from the website — the CRM inbox.
model Lead {
  id              String    @id @default(cuid())
  name            String
  phone           String
  email           String?
  // interested category slug
  category        String?
  // interested area (one of the 5 areas)
  area            String?
  // budget in PKR
  budget          Int?
  message         String
  propertyId      String?
  property        Property? @relation(fields: [propertyId], references: [id])
  // WEBSITE | CONTACT | PROPERTY | REQUIREMENT
  source          String    @default("WEBSITE")
  // NEW | CONTACTED | SITE_VISIT | NEGOTIATION | WON | LOST
  status          String    @default("NEW")
  // internal notes (admin)
  notes           String?
  // WhatsApp webhook delivery: PENDING | SENT | FAILED | SKIPPED
  waStatus        String    @default("PENDING")
  waSentAt        DateTime?
  waError         String?
  // Follow-up reminders — managed via raw SQL (self-healing columns, see
  // src/lib/lead-followup.ts). Documented here for schema parity only.
  followUpAt      DateTime?
  lastContactedAt DateTime?
  // JSON array of CRM activity entries [{at, type, detail}] — appended on
  // status changes, note edits, follow-ups and WhatsApp (re)sends.
  activities      String    @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Single-admin auth (password hashed with scrypt: "salt:hash" hex)
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String   @default("Administrator")
  passwordHash String
  createdAt    DateTime @default(now())
}

// Key-value store for panel settings (webhook_url, whatsapp_number, ...)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Scheduled property viewing — booked by the admin for a customer.
model SiteVisit {
  id          String    @id @default(cuid())
  name        String
  phone       String
  // Optional listing the visit is booked against
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id])
  // One of the 5 areas (free context when no property is chosen)
  area        String?
  // When the customer is expected (ISO datetime)
  scheduledAt DateTime
  // PLANNED | DONE | NO_SHOW | CANCELLED
  status      String    @default("PLANNED")
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
