# City Line Property — environment template
# Copy to .env and adjust. NOTE: .env is gitignored (never commit real secrets).

# SQLite database (path is relative to prisma/schema.prisma for the Prisma CLI).
# At RUNTIME the app also auto-falls-back to <project root>/db/custom.db when
# this variable is missing (see src/lib/db.ts), so deployments from GitHub
# work even without a .env file.
DATABASE_URL=file:../db/custom.db
